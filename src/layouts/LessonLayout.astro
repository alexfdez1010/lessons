---
/**
 * LessonLayout.astro — wraps a single rendered lesson.
 * Renders breadcrumbs, an article header (title + meta), a two-column body
 * with the prose on the left and a sticky table-of-contents on the right,
 * and a prev/next pager. Builds Article/Course JSON-LD from props.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { LessonComplete } from '@/components/react';
import { SITE } from '@/lib/site';
import { useTranslations, localizePath, type Lang } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  topicTitle: string;
  topicSlug: string;
  lessonSlug: string;
  courseLessonSlugs: string[];
  lang: Lang;
  minutes?: number;
  updated?: Date;
  image?: string;
  keywords?: string[];
  noindex?: boolean;
  alternates?: { lang: string; href: string }[];
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
  /** Headings from Astro's MDX render. Only depth 2–3 are shown in the TOC. */
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  topicTitle,
  topicSlug,
  lessonSlug,
  courseLessonSlugs,
  lang,
  minutes,
  updated,
  image,
  keywords,
  noindex,
  alternates,
  prev,
  next,
  headings = [],
} = Astro.props;

const t = useTranslations(lang);

const topicHref = localizePath(`/${topicSlug}`, lang);
const lessonHref = localizePath(`/${topicSlug}/${lessonSlug}`, lang);

const crumbs = [
  { label: t('nav.home'), href: localizePath('/', lang) },
  { label: topicTitle, href: topicHref },
  { label: title },
];

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const lessonPosition = courseLessonSlugs.indexOf(lessonSlug) + 1;
const lessonPositionLabel = lang === 'es'
  ? `Lección ${lessonPosition} de ${courseLessonSlugs.length}`
  : `Lesson ${lessonPosition} of ${courseLessonSlugs.length}`;

const dateFmt = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' });
const updatedLabel = updated ? dateFmt.format(updated) : undefined;

const canonical = new URL(lessonHref, Astro.site ?? Astro.url.origin).href;

// Article + breadcrumb structured data.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    author: { '@type': 'Organization', name: SITE.author },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: canonical,
    ...(updated ? { dateModified: updated.toISOString() } : {}),
    isPartOf: {
      '@type': 'Course',
      name: topicTitle,
      url: new URL(topicHref, Astro.site ?? Astro.url.origin).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: new URL(c.href, Astro.site ?? Astro.url.origin).href } : {}),
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  lang={lang}
  alternates={alternates}
  image={image}
  keywords={keywords}
  noindex={noindex}
  modifiedTime={updated?.toISOString()}
  jsonLd={jsonLd}
  mainClass="mx-auto w-full max-w-6xl px-4 pb-16 pt-8 sm:px-6"
>
  <Breadcrumbs items={crumbs} />

  <!-- Article header -->
  <header class="mt-8 max-w-3xl animate-fade-up sm:mt-10">
    <h1 class="text-3xl font-bold leading-tight text-ink-900 sm:text-[2.75rem]">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-600">{description}</p>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-ink-600">
      {lessonPosition > 0 && <span class="font-medium text-brand-700">{lessonPositionLabel}</span>}
      {
        minutes != null && (
          <span class="inline-flex items-center gap-1.5">
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {minutes} {t('lesson.minutes')}
          </span>
        )
      }
      {updatedLabel && <time datetime={updated?.toISOString()}>{t('lesson.updated')} {updatedLabel}</time>}
    </div>
  </header>

  {
    toc.length > 0 && (
      <details class="lesson-contents mt-8 rounded-card bg-surface p-1 shadow-soft lg:hidden">
        <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-4 py-3 font-semibold text-ink-800">
          {t('lesson.toc')}
          <svg class="contents-chevron h-4 w-4 shrink-0 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <nav aria-label={t('lesson.toc')} class="max-h-[min(60vh,28rem)] overflow-y-auto overscroll-contain px-1 pb-2">
          <ul class="space-y-1 text-sm">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class:list={[
                    'lesson-toc-link block rounded-lg px-3 py-2.5 leading-relaxed text-ink-600 transition-colors hover:bg-surface-sunken hover:text-brand-700',
                    h.depth === 3 && 'pl-7 text-[0.8125rem]',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )
  }

  <!-- Body + TOC -->
  <div class="mt-10 gap-12 lg:mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem]">
    <article class="prose prose-lg prose-lesson min-w-0">
      <slot />
    </article>

    {
      toc.length > 0 && (
        <aside class="hidden lg:block">
          <nav aria-label={t('lesson.toc')} class="sticky top-24 rounded-card bg-surface p-3">
            <p class="px-3 pb-3 pt-2 text-sm font-semibold text-ink-800">
              {t('lesson.toc')}
            </p>
            <ul class="max-h-[calc(100dvh-12rem)] space-y-1 overflow-y-auto overscroll-contain text-sm">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class:list={[
                      'lesson-toc-link block rounded-lg px-3 py-2 leading-relaxed text-ink-600 transition-colors hover:bg-surface-sunken hover:text-brand-700',
                      h.depth === 3 && 'pl-6 text-[0.8125rem]',
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>

  <!-- Per-lesson completion toggle (locale-agnostic, stored by bare slugs) -->
  <LessonComplete
    client:visible
    topicSlug={topicSlug}
    lessonSlug={lessonSlug}
    courseLessonSlugs={courseLessonSlugs}
    markLabel={t('lesson.markComplete')}
    finishedLabel={t('lesson.complete')}
    undoLabel={t('lesson.undoComplete')}
  />

  {
    toc.length > 0 && (
      <script>
        // Scroll-spy: highlight the TOC link for the section currently in view.
        const links = Array.from(
          document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
        );
        // Both responsive indexes refer to the same headings. Keep their
        // accessible current-location state synchronized without duplicate IDs.
        const byId = new Map<string, HTMLAnchorElement[]>();
        for (const link of links) {
          const slug = link.dataset.tocLink!;
          const group = byId.get(slug) ?? [];
          group.push(link);
          byId.set(slug, group);
        }
        const heads = Array.from(byId.keys())
          .map((slug) => document.getElementById(slug))
          .filter((el): el is HTMLElement => el !== null);

        let current: string | undefined;
        const setActive = (slug: string | undefined) => {
          if (slug === current) return;
          if (current) byId.get(current)?.forEach((link) => link.removeAttribute('aria-current'));
          if (slug) byId.get(slug)?.forEach((link) => link.setAttribute('aria-current', 'location'));
          current = slug;
        };

        const onScroll = () => {
          // Last heading whose top has passed the spy line (120px from top).
          let activeSlug: string | undefined;
          for (const h of heads) {
            if (h.getBoundingClientRect().top <= 120) activeSlug = h.id;
            else break;
          }
          setActive(activeSlug ?? heads[0]?.id);
        };

        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      </script>
    )
  }

  <!-- Prev / next pager -->
  {
    (prev || next) && (
      <nav
        aria-label={lang === 'es' ? 'Navegación entre lecciones' : 'Lesson navigation'}
        class="mt-12 grid gap-4 sm:grid-cols-2"
      >
        {prev ? (
          <a
            href={prev.href}
            class="group flex min-h-28 flex-col justify-center rounded-card bg-surface p-5 transition-colors hover:bg-surface-sunken sm:p-6"
          >
            <span class="text-sm font-medium text-ink-600">
              ← {t('lesson.prev')}
            </span>
            <span class="mt-1 font-display font-semibold text-ink-800 group-hover:text-brand-700">
              {prev.title}
            </span>
          </a>
        ) : (
          <span aria-hidden="true" class="hidden sm:block" />
        )}
        {next ? (
          <a
            href={next.href}
            class="group flex min-h-28 flex-col justify-center rounded-card bg-brand-50 p-5 text-right transition-colors hover:bg-brand-100 sm:p-6"
          >
            <span class="text-sm font-medium text-ink-600">
              {t('lesson.next')} →
            </span>
            <span class="mt-1 font-display font-semibold text-ink-800 group-hover:text-brand-700">
              {next.title}
            </span>
          </a>
        ) : (
          <span aria-hidden="true" class="hidden sm:block" />
        )}
      </nav>
    )
  }
</BaseLayout>

<style>
  article :global(h2[id]),
  article :global(h3[id]) {
    scroll-margin-top: 6rem;
  }

  .lesson-contents summary::-webkit-details-marker {
    display: none;
  }

  .lesson-contents[open] .contents-chevron {
    transform: rotate(180deg);
  }

  .lesson-toc-link[aria-current='location'] {
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    font-weight: 600;
  }
</style>
