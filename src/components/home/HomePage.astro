---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CompoundingCurve } from '@/components/react';
import { getTopics, getLessons } from '@/lib/content';
import { getRoadmapSummaries, roadmapHref } from '@/lib/roadmaps';
import { getDifficultyLabels } from '@/lib/catalog';
import { useTranslations, localizePath, alternates as alternatesFor, type Lang } from '@/i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const topics = await getTopics(lang);
const lessons = await getLessons(lang);
const roadmaps = await getRoadmapSummaries(lang);
const difficultyLabels = getDifficultyLabels(lang);
const tiers = ['beginner', 'intermediate', 'advanced', 'expert'] as const;
const catalogHref = localizePath('/catalog', lang);
const firstLessons = lessons.filter((lesson) => lesson.topicSlug === 'money-and-value');
const firstLesson = firstLessons[0];
const startHref = firstLesson
  ? localizePath(`/${firstLesson.topicSlug}/${firstLesson.lessonSlug}`, lang)
  : catalogHref;
const alts = alternatesFor(Astro.url).map((a) => ({ lang: a.lang, href: a.path }));
const lessonHrefs = lessons.map((l) => localizePath(`/${l.topicSlug}/${l.lessonSlug}`, lang));

const copy = {
  en: {
    description: 'Learn finance from zero with interactive examples, visual explanations and quizzes. Free, in English and Spanish.',
    title: 'Finance makes sense when you try it',
    intro: 'From understanding money to pricing options. Explore visual examples, move the controls and put what you learn into practice.',
    start: 'Start from zero', access: 'Free access, no account needed',
    courses: 'courses', lessons: 'lessons', demoLink: 'Explore compound interest',
    curveTitle: 'Watch interest earn interest', rate: 'Annual rate', years: 'Years', initial: 'Start',
    compound: 'Compound interest', simple: 'Simple interest', final: 'Final value', annual: 'Annual return',
    caption: 'Simple interest earns on your starting amount. Compound interest also earns on previous interest.',
    chartLabel: '{title}: {start} at {rate}% a year for {years} years reaches {compound} with compound interest and {simple} with simple interest.',
    beginning: 'Your first steps',
    beginningBody: 'Start with what money is, how a payment works and how to keep track of it. No prior knowledge needed.',
    courseLink: 'See the first course', levels: 'From beginner to expert',
    tierDescriptions: ['Money, saving and your first investment', 'Markets, funds, bonds and credit', 'Portfolios, valuation and risk models', 'Options pricing and quantitative finance'],
    paths: 'Choose what you want to understand', morePaths: 'More learning paths',
    random: 'Try a random lesson', ready: 'Find your next lesson',
  },
  es: {
    description: 'Aprende finanzas desde cero con ejemplos interactivos, explicaciones visuales y ejercicios. Gratis, en español e inglés.',
    title: 'Las finanzas se entienden practicando',
    intro: 'Desde entender el dinero hasta valorar opciones. Explora ejemplos visuales, mueve los controles y pon a prueba lo que aprendes.',
    start: 'Empezar desde cero', access: 'Acceso gratuito, sin crear una cuenta',
    courses: 'cursos', lessons: 'lecciones', demoLink: 'Explorar el interés compuesto',
    curveTitle: 'Cuando los intereses generan intereses', rate: 'Tipo anual', years: 'Años', initial: 'Inicio',
    compound: 'Interés compuesto', simple: 'Interés simple', final: 'Valor final', annual: 'Rentabilidad anual',
    caption: 'El interés simple se calcula sobre el importe inicial. El compuesto también genera intereses sobre los anteriores.',
    chartLabel: '{title}: {start} al {rate}% anual durante {years} años se convierten en {compound} con interés compuesto y en {simple} con interés simple.',
    beginning: 'Tus primeros pasos',
    beginningBody: 'Empieza por qué es el dinero, cómo funciona un pago y cómo llevar las cuentas. Sin conocimientos previos.',
    courseLink: 'Ver el primer curso', levels: 'De principiante a experto',
    tierDescriptions: ['Dinero, ahorro y tu primera inversión', 'Mercados, fondos, bonos y crédito', 'Carteras, valoración y modelos de riesgo', 'Valoración de opciones y finanzas cuantitativas'],
    paths: 'Elige qué quieres entender', morePaths: 'Más rutas de aprendizaje',
    random: 'Probar una lección al azar', ready: 'Encuentra tu próxima lección',
  },
}[lang];
---

<BaseLayout title={t('home.seoTitle')} description={copy.description} lang={lang} alternates={alts}
  mainClass="mx-auto w-full max-w-6xl px-5 sm:px-8">
  <section class="grid items-center gap-10 pb-14 pt-10 sm:gap-14 sm:pb-20 sm:pt-16 lg:grid-cols-[1fr_1.08fr] lg:gap-16 lg:py-20">
    <div class="animate-fade-up">
      <h1 class="max-w-xl text-[2.65rem] font-semibold leading-[1.12] tracking-[-0.045em] text-ink-900 sm:text-6xl lg:text-[3.5rem]">{copy.title}</h1>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-600 sm:mt-6 sm:text-lg">{copy.intro}</p>
      <div class="mt-7 flex flex-wrap items-center gap-3 sm:mt-8">
        <a href={startHref} class="inline-flex min-h-12 items-center justify-center gap-3 rounded-xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-800">
          {copy.start}
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href={catalogHref} class="inline-flex min-h-12 items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50">{t('hero.cta.catalog')}</a>
      </div>
      <p class="mt-4 text-sm text-ink-600">{copy.access}</p>
      <dl class="mt-8 flex gap-8 sm:mt-10">
        <div class="flex items-baseline gap-2"><dt class="order-2 text-sm text-ink-600">{copy.courses}</dt><dd class="font-display text-2xl font-semibold text-ink-900">{topics.length}</dd></div>
        <div class="flex items-baseline gap-2"><dt class="order-2 text-sm text-ink-600">{copy.lessons}</dt><dd class="font-display text-2xl font-semibold text-ink-900">{lessons.length}</dd></div>
      </dl>
    </div>
    <div class="home-demo rounded-3xl bg-surface p-5 shadow-soft sm:p-7">
      <CompoundingCurve client:visible title={copy.curveTitle} rateLabel={copy.rate} yearsLabel={copy.years}
        startLabel={copy.initial} compoundLabel={copy.compound} simpleLabel={copy.simple}
        finalValueLabel={copy.final} cagrLabel={copy.annual} caption={copy.caption} currencyPrefix={lang === 'es' ? '€' : '$'}
        locale={lang === 'es' ? 'es-ES' : 'en-US'} chartLabel={copy.chartLabel} />
      <a href={localizePath('/interest-and-yield', lang)} class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">{copy.demoLink}</a>
    </div>
  </section>

  <section class="grid gap-10 py-10 sm:py-14 lg:grid-cols-[1fr_1.08fr] lg:gap-16">
    <div>
      <h2 class="text-2xl font-semibold sm:text-3xl">{copy.beginning}</h2>
      <p class="mt-4 max-w-md leading-relaxed text-ink-600">{copy.beginningBody}</p>
      <ol class="mt-6 space-y-2">
        {firstLessons.slice(0, 3).map((lesson, i) => (
          <li>
            <a href={localizePath(`/${lesson.topicSlug}/${lesson.lessonSlug}`, lang)} class="group flex min-h-16 items-center gap-4 rounded-xl px-3 py-3 transition-colors hover:bg-surface-sunken">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand-100 font-display text-sm font-medium text-brand-800">{i + 1}</span>
              <span class="min-w-0 flex-1 text-sm font-semibold leading-relaxed text-ink-800 group-hover:text-brand-700">{lesson.entry.data.title}</span>
              {lesson.entry.data.minutes && <span class="shrink-0 text-xs text-ink-600">{lesson.entry.data.minutes} {t('lesson.minutes')}</span>}
            </a>
          </li>
        ))}
      </ol>
      <a href={localizePath('/money-and-value', lang)} class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">{copy.courseLink}</a>
    </div>
    <div class="rounded-3xl bg-surface-sunken p-5 sm:p-7">
      <h2 class="text-xl font-semibold sm:text-2xl">{copy.levels}</h2>
      <ol class="mt-5 space-y-2">
        {tiers.map((tier, i) => (
          <li>
            <a href={`${catalogHref}?level=${tier}`} class="group flex items-center justify-between gap-4 rounded-xl px-3 py-4 transition-colors hover:bg-surface">
              <div>
                <h3 class="text-sm font-semibold text-brand-900 group-hover:text-brand-700">{difficultyLabels[tier]}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-600">{copy.tierDescriptions[i]}</p>
              </div>
              <span class="shrink-0 text-sm tabular-nums text-ink-600">{topics.filter((topic) => topic.entry.data.difficulty === tier).length} {copy.courses}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-12 sm:py-16" aria-labelledby="learning-paths">
    <h2 id="learning-paths" class="max-w-2xl text-2xl font-semibold sm:text-3xl">{copy.paths}</h2>
    <div class="mt-7 grid gap-x-10 gap-y-3 sm:grid-cols-2 lg:gap-x-16">
      {roadmaps.slice(0, 6).map((r) => (
        <a href={roadmapHref(r.meta.tag, lang)} class="group flex items-start gap-4 rounded-2xl p-4 transition-colors hover:bg-surface">
          <span aria-hidden="true" class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-surface text-xl">{r.meta.icon}</span>
          <div class="min-w-0">
            <h3 class="text-base font-semibold leading-snug group-hover:text-brand-700">{r.meta.title[lang]}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{r.meta.description[lang]}</p>
            <p class="mt-2 text-xs font-medium text-brand-700">{r.courseCount} {copy.courses}</p>
          </div>
        </a>
      ))}
    </div>
    {roadmaps.length > 6 && <details class="group mt-6">
      <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50 [&::-webkit-details-marker]:hidden">
        {copy.morePaths}
        <svg viewBox="0 0 20 20" class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </summary>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {roadmaps.slice(6).map((r) => <li><a href={roadmapHref(r.meta.tag, lang)} class="flex min-h-14 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-ink-700 transition-colors hover:bg-surface hover:text-brand-700"><span aria-hidden="true">{r.meta.icon}</span>{r.meta.title[lang]}</a></li>)}
      </ul>
    </details>}
  </section>

  <nav aria-label={copy.ready} class="mb-8 mt-4 flex flex-wrap items-center gap-3 py-6">
    <a href={catalogHref} class="inline-flex min-h-12 items-center rounded-xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-800">{t('hero.cta.catalog')}</a>
    <a href={catalogHref} data-random-lesson data-lessons={JSON.stringify(lessonHrefs)} class="inline-flex min-h-12 items-center rounded-xl px-4 py-3 text-sm font-medium text-brand-700 hover:bg-brand-50">{copy.random}</a>
  </nav>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('a[data-random-lesson]').forEach((el) => {
      let lessons: string[] = [];
      try { lessons = JSON.parse(el.dataset.lessons || '[]'); } catch { /* Follow the catalog link. */ }
      el.addEventListener('click', (event) => {
        if (!lessons.length || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        window.location.href = lessons[Math.floor(Math.random() * lessons.length)];
      });
    });
  </script>
</BaseLayout>

<style>
  .home-demo :global(figure) { margin: 0; border: 0; padding: 0; background: transparent; box-shadow: none; }
  .home-demo :global(figcaption) { flex-wrap: wrap; }
  .home-demo :global(input[type='range']) { min-height: 1.5rem; }
</style>
