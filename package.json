{
  "name": "lessons",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Alejandro Fernández Camello",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_OPTIONS=--max-old-space-size=${BUILD_MAX_HEAP:-12288} astro build",
    "preview": "astro preview",
    "test": "bun test",
    "astro": "astro",
    "check": "bun run check:latex && bun run check:island-latex && astro check && tsc --noEmit",
    "check:latex": "bun run scripts/check-latex.ts",
    "check:island-latex": "bun run scripts/check-island-latex.ts",
    "audit": "bun audit",
    "audit:fix": "bun update && bun run audit",
    "og:generate": "bun run scripts/generate-og.ts",
    "og:changed": "bun run scripts/generate-og.ts --changed",
    "og:build": "bun run build && bun run og:generate",
    "pre-commit": "bun run check && bun run build && bun run og:changed",
    "deploy": "bun run build && bun run deploy:assets",
    "deploy:assets": "wrangler deploy",
    "preview:cloudflare": "wrangler dev"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.20",
    "katex": "^0.19.1",
    "playwright": "^1.65.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "path-to-regexp": ">=6.3.0 <7",
    "tar": ">=7.5.16",
    "js-yaml": ">=4.3.2 <5",
    "dompurify": "^3.4.17",
    "smol-toml": "^1.9.1",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^6.1.5",
    "baseline-browser-mapping": "^2.11.0",
    "svgo": "^4.1.0",
    "zod": ">=4.6.6 <5",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.9",
    "browserslist": "^4.29.5",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1"
  }
}
